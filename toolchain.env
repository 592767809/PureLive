# Single source of truth for the toolchain (docs/specs/ENGINEERING.md §3). tools/check_latest
# compares it with the latest official stable releases; update it only
# together with a verified upgrade of the local environment.
FLUTTER_VERSION=3.47.8
# Official merged semantics fix; explicit isolated SDK preparation: tools/flutter_sdk/README.md
FLUTTER_REVISION=737ba8f885dc774b53b442759999a312c9461e4e
FLUTTER_PATCH_SHA256=f5fd56c5a0b6e73b31411f6820dcb4c1eecad672e28ccad8cbb3698eeaaf8dd3
DART_VERSION=3.13.7
GRADLE_VERSION=9.8.2
AGP_VERSION=9.4.1
# Kotlin Gradle Plugin used by AGP built-in Kotlin.
KOTLIN_VERSION=2.4.21
# Exact Temurin patch release as well as the feature line.
JDK_FEATURE_VERSION=27
JDK_VERSION=27.0.1.0.2+1
# compileSdk major.minor; the Android build reads it (android/build.gradle.kts).
ANDROID_COMPILE_SDK=37.2
ANDROID_BUILD_TOOLS=37.0.0
# NDK for every Android module (it also strips the native libraries).
ANDROID_NDK_VERSION=30.0.16248370
ANDROID_PLATFORM_TOOLS=37.0.1
ANDROID_CMDLINE_TOOLS=23.0
ANDROID_CLI_VERSION=1.1.16717390
# The newest CMake in the Android SDK (no Android module builds C++ today).
ANDROID_CMAKE_VERSION=4.1.2
# Standalone Linux/Windows tooling. Flutter Windows uses the CMake component
# shipped with the current Visual Studio release (4.3.1-msvc1), not PATH CMake.
CLANG_VERSION=23.1.4
CMAKE_VERSION=4.4.4
NINJA_VERSION=1.13.2
VISUAL_STUDIO_VERSION=18.11.2
INNO_SETUP_VERSION=7.1.0
PYTHON_VERSION=3.15.2
# Explicit final Xcode selection; a newer RC in the runner is not selected.
XCODE_VERSION=27.1
COCOAPODS_VERSION=1.17.0
MPV_VERSION=0.41.0
FFMPEG_VERSION=9.0.2
# Self-maintained media_kit fork: upstream repository and commit.
MEDIA_KIT_UPSTREAM_REPO=Predidit/media-kit
MEDIA_KIT_UPSTREAM_COMMIT=83b7ca63772856e1ea0158916177e136f7b7b0be
